# Mail delivery for the site forms (app/api/contact, app/api/forms/[slug]).
# Every submission is emailed and nothing is stored, so without these values
# in production the forms will fail. Locally you can leave SMTP_HOST unset —
# the submission is then printed to the terminal instead of being sent.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_SECURE=true      # only needed when using port 465
SMTP_USER=office@almagor-yaarit.com
SMTP_PASS=              # Google Workspace: an App Password, not the login password

# Envelope. MAIL_FROM must be a domain you control and that has SPF/DKIM set up,
# otherwise the mail lands in spam.
MAIL_FROM="סוכנות יערית · טפסי האתר <office@almagor-yaarit.com>"
MAIL_TO=office@almagor-yaarit.com

# ── Mslahtk CRM (lead capture → customer card) ──────────────────────────────
# Trusted server-to-server route, same as Verox. Leave unset and the forms keep
# working email-only; set both and every submission also creates a customer card.
# prod: https://intake-api.mslahtk.ai | staging: https://intake-api-staging.mslahtk.ai
MSLAHTK_API_BASE=https://intake-api.mslahtk.ai
MSLAHTK_PROJECT_ID=            # from the project once it is registered
MSLAHTK_SERVICE_TOKEN=         # admin → service accounts → create (shown once)
