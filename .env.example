# ── Database (Postgres on Railway; locally any Postgres) ─────────────────────
# The system of record: every submission, every file's key, the Mslahtk link.
# On Railway: reference the Postgres service, DATABASE_URL=${{Postgres.DATABASE_URL}}.
# `npm start` runs `prisma migrate deploy` first, so the schema is always applied
# before the code that needs it. Prisma's CLI reads .env (not .env.local), so
# locally put DATABASE_URL in .env and everything else in .env.local.
DATABASE_URL=postgresql://user:password@localhost:5432/yarit_dev?schema=public

# ── File storage (Cloudflare R2, the standard for every custom system) ───────
# A PRIVATE bucket. Files are put from the server and read through
# /admin/files/<id>, which answers with a 5-minute signed URL for a signed-in
# admin only. Normally Mslahtk's "Upgrade the site to a system" creates the
# bucket and writes these four values into the Railway service. Manual setup:
# one R2 API token (Admin Read & Write so `npm run r2:setup` can create the
# bucket; Object Read & Write on the bucket if it already exists).
# R2_ACCOUNT_ID is the Cloudflare account id (CLOUDFLARE_ACCOUNT_ID also works).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yarit-files
# Optional. Unset: R2 when configured, else "disk" (.data/uploads) outside
# production. In production without R2 the files ride the email only.
# STORAGE_DRIVER=disk

# ── Mslahtk (the CRM: customer card, pipeline, WhatsApp, owner dashboard) ────
# Every submission is also filed as a lead over the trusted server-to-server
# route. Leave the token unset and the site keeps working without the CRM.
# prod: https://intake-api.mslahtk.ai | staging: https://intake-api-staging.mslahtk.ai
# These are the names Mslahtk's "Connect app" writes; the site's older names
# (MSLAHTK_API_BASE, ADMIN_LINK_SECRET) are accepted as aliases.
MSLAHTK_API=https://intake-api.mslahtk.ai
MSLAHTK_PROJECT_ID=            # the business's project id in Mslahtk
MSLAHTK_SERVICE_TOKEN=         # service account, preset "site-backend" (shown once)
# Signs the launch tokens Mslahtk mints for /admin/entry, the session cookie,
# the re-send links, AND Mslahtk's webhook deliveries to /mslahtk/webhook.
MSLAHTK_CONNECTION_SECRET=
# Where "open in Mslahtk" links point.
MSLAHTK_DASHBOARD_URL=https://intake.mslahtk.ai
# Hours a launch click stays signed in (default 8).
# ADMIN_SESSION_TTL_H=8

# ── Mail (the notification to the agency mailbox) ────────────────────────────
# Locally you can leave SMTP_HOST unset: the email is printed to the terminal.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# SMTP_SECURE=true      # only when using port 465
SMTP_USER=office@almagor-yaarit.com
SMTP_PASS=              # Google Workspace / Microsoft 365: an App Password, not the login password
# Envelope. MAIL_FROM must be a domain you control with SPF/DKIM set up,
# otherwise the mail lands in spam.
MAIL_FROM="סוכנות יערית · טפסי האתר <office@almagor-yaarit.com>"
MAIL_TO=office@almagor-yaarit.com
